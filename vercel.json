{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "admin/**/*.php",
      "use": "vercel-php"
    },
    {
      "src": "api/**/*.php",
      "use": "vercel-php"
    },
    {
      "src": "*.php",
      "use": "vercel-php"
    }
  ],
  "routes": [
    {
      "src": "/admin/?$",
      "dest": "/admin/index.php"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/gallery",
      "dest": "/gallery.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
